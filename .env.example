# Nebius Token Factory key. https://tokenfactory.nebius.com/
NEBIUS_API_KEY=

# Tavily key. https://tavily.com/
TAVILY_API_KEY=

# auto (default): live when both keys are set, otherwise the five cached demos.
# mock: always cached demos, even if keys are present.
# live: require both keys.
RECEIPTS_MODE=auto

# OpenAI-compatible Token Factory base URL.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Model ids. Super settles the pages. Ultra is only the availability fallback.
NEBIUS_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_CHECK_FALLBACK_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b